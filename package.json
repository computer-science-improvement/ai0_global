{
  "name": "ai0-global",
  "version": "1.0.0",
  "private": true,
  "description": "AI content pipeline and channel automation monorepo",
  "scripts": {
    "db:up": "docker compose up postgres -d",
    "db:down": "docker compose stop postgres",
    "db:init": "pnpm --filter pipeline run init-db",
    "db:migrate": "bash database/migrate.sh",
    "dev:automation": "pnpm --filter automation run start:dev",
    "prod:up": "docker compose --profile prod up -d",
    "prod:down": "docker compose --profile prod down",
    "prod:logs": "docker compose --profile prod logs -f automation",
    "pipeline:sync": "docker compose --profile pipeline run --rm pipeline pnpm run sync",
    "pipeline:load": "docker compose --profile pipeline run --rm pipeline pnpm run load:all",
    "pipeline:parse": "docker compose --profile pipeline run --rm pipeline pnpm run parse"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  },
  "pnpm": {
    "overrides": {
      "@modelcontextprotocol/sdk": "^1.32.1",
      "hono": "^4.13.13",
      "@hono/node-server": "^1.19.15",
      "proxy-addr": "^2.0.8",
      "seroval": "^1.7.0",
      "seroval-plugins": "^1.6.12",
      "fast-uri": "^3.1.8",
      "ip-address": "^10.7.1",
      "js-yaml@^4": "^4.2.0",
      "brace-expansion@^1": "^1.1.21",
      "brace-expansion@^2": "^2.1.7",
      "brace-expansion@^5": "^5.0.12",
      "picomatch@^3": "^3.0.2",
      "picomatch@^4": "^4.0.4",
      "path-to-regexp@~0.1": "~0.1.12",
      "path-to-regexp@^3": "^3.3.0",
      "body-parser@^1": "^1.20.6",
      "body-parser@^2": "^2.3.0",
      "multer@^2": "^2.3.0",
      "qs@^6": "^6.16.0",
      "lodash": "^4.18.0",
      "postcss": "^8.5.23",
      "nanoid@^3": "^3.3.18",
      "browserslist": "^4.28.7",
      "glob@^10": "^10.5.0",
      "form-data@^4": "^4.0.6",
      "source-map-js": "^1.2.2",
      "follow-redirects": "^1.16.0",
      "ajv@^8": "^8.18.0",
      "fflate@~0.7": "~0.7.5",
      "@humanfs/node": "^0.16.8",
      "baseline-browser-mapping": "^2.11.0",
      "moment": "^2.31.0",
      "@babel/core": "^7.29.6",
      "webpack@^5": "^5.104.1"
    }
  }
}
