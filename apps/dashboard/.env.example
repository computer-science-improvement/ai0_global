# Leave empty: api() paths already include /api, /tracking, … (see src/lib/env.ts).
VITE_API_BASE_URL=
VITE_AUTH_BASE_URL=/auth
# Sign-in method (src/lib/auth-mode.ts): a bot username → Telegram; token → the
# access-token form. A production `vite build` with neither fails (spec 028).
VITE_TG_BOT_USERNAME=
VITE_AUTH_MODE=
# Escape hatch for a deliberate local-only production build with no sign-in
# method (the backend's ALLOW_NO_AUTH bypass decides access). Never for a deploy.
VITE_ALLOW_DEV_AUTH=
