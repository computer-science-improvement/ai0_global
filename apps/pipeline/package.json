{
  "name": "pipeline",
  "version": "1.0.0",
  "description": "Data pipeline: parsers, loaders, DB init",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "init-db": "node --env-file=../../.env src/init-db.js",
    "init-db:reset": "node --env-file=../../.env src/init-db.js --reset",
    "parse": "node src/run-parsers.js",
    "test": "node --test",
    "parse:recipes": "node src/parsers/recipes-epicure.js",
    "parse:academy": "node src/parsers/academy.openai.js",
    "parse:academy:resources": "node src/parsers/academy.openai.resources.js",
    "parse:md": "node src/parsers/prompts-md.js",
    "parse:mcpservers": "node src/parsers/mcpservers.js",
    "parse:samorozvytok": "node src/parsers/samorozvytok-motivatory.js",
    "parse:samorozvytok:test": "PARSE_LIMIT=3 node src/parsers/samorozvytok-motivatory.js",
    "load": "node --env-file=../../.env src/loaders/assets.js",
    "load:test": "LOAD_LIMIT=5 node --env-file=../../.env src/loaders/assets.js",
    "load:prompts": "node --env-file=../../.env src/loaders/prompts.js",
    "load:prompts:test": "LOAD_LIMIT=5 node --env-file=../../.env src/loaders/prompts.js",
    "load:daytoday": "node --env-file=../../.env src/loaders/daytoday.js",
    "load:daytoday:test": "LOAD_LIMIT=5 node --env-file=../../.env src/loaders/daytoday.js",
    "scrape:prompts-github": "node src/tools/scrape-prompts-github.js",
    "scrape:treatfield": "node src/tools/additional-data/scripts/scrape-treatfield-articles.js",
    "load:treatfield": "node --env-file=../../.env src/loaders/treatfield.js",
    "load:treatfield:test": "LOAD_LIMIT=5 node --env-file=../../.env src/loaders/treatfield.js",
    "load:recipes": "node --env-file=../../.env src/loaders/recipes.js",
    "load:recipes:test": "LOAD_LIMIT=5 node --env-file=../../.env src/loaders/recipes.js",
    "load:recipes:fresh": "LOAD_FRESH=1 node --env-file=../../.env src/loaders/recipes.js",
    "load:facts": "node --env-file=../../.env src/loaders/facts.js",
    "load:facts:test": "LOAD_LIMIT=5 node --env-file=../../.env src/loaders/facts.js",
    "load:pdr": "node --env-file=../../.env src/loaders/pdr.js",
    "load:tg-posts": "node --env-file=../../.env src/loaders/tg-posts.js",
    "load:tg-posts:test": "LOAD_LIMIT=5 node --env-file=../../.env src/loaders/tg-posts.js",
    "load:all": "pnpm run load && pnpm run load:prompts && pnpm run load:daytoday && pnpm run load:recipes && pnpm run load:facts && pnpm run load:pdr && pnpm run load:tg-posts",
    "db:seed": "pnpm run init-db && pnpm run load:all",
    "db:reset": "pnpm run init-db:reset && pnpm run load:all",
    "sync": "pnpm run parse && pnpm run load:all",
    "calculator": "node --env-file=../../.env src/calculator/server.js",
    "tg:adapt-motivation": "node --env-file=../../.env src/tg/adapt-motivation.js",
    "tg:adapt-motivation:test": "ADAPT_LIMIT=3 node --env-file=../../.env src/tg/adapt-motivation.js",
    "tg:adapt-samorozvytok": "node src/tg/adapt-samorozvytok.js",
    "tg:adapt-samorozvytok:test": "ADAPT_LIMIT=3 node src/tg/adapt-samorozvytok.js",
    "tg:adapt-biographies": "node --env-file=../../.env src/tg/adapt-biographies.js",
    "tg:adapt-biographies:test": "ADAPT_LIMIT=3 node --env-file=../../.env src/tg/adapt-biographies.js"
  },
  "keywords": [
    "parser",
    "scraper",
    "pipeline"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "cheerio": "^1.0.0-rc.12",
    "pg": "^8.11.3",
    "playwright": "^1.58.2"
  }
}
