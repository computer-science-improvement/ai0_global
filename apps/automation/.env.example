# Tracking module (Phase 1)
REDIS_URL=redis://localhost:6379
TRACKING_ENABLED=true
TRACKING_POLL_INTERVAL_HOT_MIN=5
TRACKING_POLL_INTERVAL_WARM_MIN=30
TRACKING_POLL_INTERVAL_COLD_HOURS=6
TRACKING_VIEW_TO_SUB_RATE=0.02
TRACKING_TOKEN=changeme-bearer-token

# Tracking MTProto session — must be a SECOND user account session, distinct from
# TELEGRAM_SESSION_STRING used by stats. Telegram disallows two concurrent
# connections with the same session ("AUTH_KEY_DUPLICATED").
TELEGRAM_TRACKING_SESSION_STRING=
# Escape hatch: set to "true" to reuse the stats session if you accept that
# AUTH_KEY_DUPLICATED will kill ONE of the two clients.
TELEGRAM_TRACKING_SHARE_SESSION=false

# Auth (Phase 2)
JWT_SECRET=change-me-32-chars-min
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TRACKING_ALLOWED_TG_USER_IDS=

# Telegraph access token (api.telegra.ph). Used by recipe articles.
TELEGRAPH_ACCESS_TOKEN=

# ─── Carousel slide hosting (Supabase Storage) ───────────────────────────────
# Public-bucket host for IG/Threads carousel slides. Project + bucket are
# created in the Supabase dashboard; the service-role key is a secret.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_CAROUSEL_BUCKET=carousel

# ─── Token encryption (secrets at rest) ──────────────────────────────────────
# Master key for encrypting stored secret tokens (AES-256-GCM). Any passphrase —
# it is SHA-256'd to a 32-byte key. Required only to store/read encrypted tokens;
# legacy env-var-name (token_env) tokens keep working without it.
TOKEN_ENCRYPTION_KEY=

# ─── TikTok (Content Posting API) ────────────────────────────────────────────
# App credentials from the TikTok developer portal. Tokens themselves are stored
# in the tiktok_accounts table (they rotate on refresh), NOT here.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# TikTok post privacy. Until the TikTok app is audited this MUST be SELF_ONLY
# (posts land private on the creator's profile); set PUBLIC_TO_EVERYONE after audit.
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# TikTok OAuth scopes (comma-separated) requested at connect time.
TIKTOK_SCOPES=user.info.basic,video.publish
# Dashboard origin the OAuth callback redirects the browser back to.
DASHBOARD_URL=
