{
  "bots": {
    "ai0_global_test_bot": {
      "platform": "telegram",
      "tokenEnv": "TELEGRAM_BOT_TOKEN"
    }
  },

  "channels": {
    "@ai0_news_dev": {
      "platform": "telegram",
      "chatId": "@ai0_news_dev",
      "botId": "ai0_global_test_bot"
    },
    "@ai0_prompts_dev": {
      "platform": "telegram",
      "chatId": "@ai0_prompts_dev",
      "botId": "ai0_global_test_bot"
    },
    "@game_exchange_dev": {
      "platform": "telegram",
      "chatId": "@game_exchange_dev",
      "botId": "ai0_global_test_bot"
    },
    "@pdr_dev_channel": {
      "platform": "telegram",
      "chatId": "@pdr_dev_channel",
      "botId": "ai0_global_test_bot"
    },
    "@ai0_global": {
      "platform": "telegram",
      "chatId": "@ai0_global",
      "botId": "ai0_global_test_bot"
    }
  },

  "strategies": [

    {
      "id": "ai0-news:ai0_news_dev",
      "type": "ai0-news",
      "channelId": "@ai0_news_dev",
      "schedule": "*/30 8-22 * * *"
    },
    {
      "id": "ai0-prompts:ai0_prompts_dev",
      "type": "ai0-prompts",
      "channelId": "@ai0_prompts_dev",
      "schedule": "0 8-22/2 * * *"
    },

    {
      "id": "game-channel:game_exchange_dev",
      "type": "game-channel",
      "channelId": "@game_exchange_dev",
      "schedule": "*/30 8-22 * * *"
    },

    {
      "id": "pdr-quiz:main",
      "type": "pdr-quiz",
      "channelId": "@pdr_dev_channel",
      "schedule": "*/30 8-22 * * *"
    },

    {
      "id": "ua-news:ai0_global_open_source",
      "type": "ua-news",
      "channelId": "@ai0_global",
      "schedule": "0,30 8,11,14,17,20 * * *",
      "params": {
        "feedUrl": "https://www.artificialintelligence-news.com/categories/ai-and-us/open-source-democratised-ai/feed/",
        "sourceName": "artificialintelligence-news.com",
        "tags": ["news"]
      }
    },
    {
      "id": "ua-news:ai0_global_mcp",
      "type": "ua-news",
      "channelId": "@ai0_global",
      "schedule": "0,30 9,12,15,18,21 * * *",
      "params": {
        "feedUrl": "https://www.marktechpost.com/category/model-context-protocol-mcp/feed/",
        "sourceName": "marktechpost.com",
        "tags": ["mcp_news"]
      }
    },
    {
      "id": "ua-news:ai0_global_ai_agents",
      "type": "ua-news",
      "channelId": "@ai0_global",
      "schedule": "0,30 10,13,16,19,22 * * *",
      "params": {
        "feedUrl": "https://www.marktechpost.com/category/ai-agents/feed/",
        "sourceName": "marktechpost.com",
        "tags": ["ai_agents"]
      }
    },
    {
      "id": "assets:academy-openai",
      "type": "assets",
      "channelId": "@ai0_global",
      "schedule": "15 8,14,20 * * *",
      "params": {
        "dataSource": "academy-openai",
        "posterUrl": "https://velnkfahctctngbkopfm.supabase.co/storage/v1/object/public/ai0_global/prompt_openai_poster.jpg",
        "tag": "#openai_academy"
      }
    },
    {
      "id": "assets:mcpservers",
      "type": "assets",
      "channelId": "@ai0_global",
      "schedule": "15 10,16,22 * * *",
      "params": {
        "dataSource": "mcpservers",
        "posterUrl": "https://velnkfahctctngbkopfm.supabase.co/storage/v1/object/public/ai0_global/mcp_server_poster.png",
        "tag": "#mcp"
      }
    },
    {
      "id": "assets:prompts-md",
      "type": "assets",
      "channelId": "@ai0_global",
      "schedule": "15 12,18 * * *",
      "params": {
        "dataSource": "prompts-md",
        "posterUrl": "https://velnkfahctctngbkopfm.supabase.co/storage/v1/object/public/ai0_global/prompt_community_poster.jpg",
        "tag": "#prompt"
      }
    }

  ]
}
