# Env
.env
.env.local
# Local MCP client config (copy of .mcp.json.example) — may carry env overrides
.mcp.json

# Local-development channels overlay — user-owned, gitignored so the laptop's
# bot tokens / chat IDs never land in the repo. Used only when
# NODE_ENV=local-development. See channels.local.example.json for structure.
apps/automation/config/channels.local.json
apps/automation/config/*.local.json

# Dependencies
node_modules/
**/node_modules/
# also a node_modules *symlink* (agent worktrees link it); a trailing slash only matches directories
node_modules
# pnpm content-addressable store (created when store-dir points inside the repo).
# Was accidentally committed (3,094 files) — untracked in spec 007 T001; the
# optional history purge is in docs/runbooks/repo-history-purge.md.
.pnpm-store/

# Build output
dist/
**/dist/

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/

# Data files are versioned in repository

# Orchestration temp artifacts (plan durable files stay in tasks/<slug>/README.md, MANIFEST.md, agents/)
tasks/**/scratch/

# MemPalace per-project files (issue #185)
mempalace.yaml
entities.json
.superpowers/

# Large generated pipeline datasets — never commit (regenerable via loaders)
apps/pipeline/src/data/normalized/recipes/recipes.json
apps/pipeline/src/data/**/recipes_scraped.json

# Nightly pg_dump output from the compose `backup` profile — never commit
backups/

# PDR scraper browser session (written by pdr-login.ts) — a live credential, never commit
apps/pipeline/src/data/normalized/pdr/auth.json

# editor eval run outputs (baseline-*.md is committed)
apps/automation/evals/results/*
!apps/automation/evals/results/baseline-*.md
