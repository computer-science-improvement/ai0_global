# Env
.env
.env.local

# Local-development channels overlay — user-owned, gitignored so the laptop's
# bot tokens / chat IDs never land in the repo. Used only when
# NODE_ENV=local-development. See channels.local.example.json for structure.
apps/automation/config/channels.local.json
apps/automation/config/*.local.json

# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
**/dist/

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/

# Data files are versioned in repository

# Orchestration temp artifacts (plan durable files stay in tasks/<slug>/README.md, MANIFEST.md, agents/)
tasks/**/scratch/

# MemPalace per-project files (issue #185)
mempalace.yaml
entities.json
.superpowers/

# Large generated pipeline datasets — never commit (regenerable via loaders)
apps/pipeline/src/data/normalized/recipes/recipes.json
apps/pipeline/src/data/**/recipes_scraped.json
