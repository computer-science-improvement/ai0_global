# ─── PostgreSQL ─────────────────────────────────────────────────────────────
#
# LOCAL dev (outside Docker):
#   POSTGRES_HOST=localhost
#   POSTGRES_PORT=5433    ← host port mapped in docker-compose.yml
#
# Inside Docker (between services):
#   POSTGRES_HOST=postgres  ← docker service name (set automatically by compose)
#   POSTGRES_PORT=5432      ← internal container port (set automatically by compose)
#
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ai0global
POSTGRES_USER=ai0
POSTGRES_PASSWORD=__set_a_strong_password__

# ─── Network exposure / Redis ───────────────────────────────────────────────
# Host address that docker-compose publishes postgres, redis and automation on.
# Default 127.0.0.1 (loopback only). If you rely on remote psql to 5433, set
# BIND_ADDR=0.0.0.0 explicitly — and firewall it.
BIND_ADDR=127.0.0.1
# Same, for the dashboard port only. Keep loopback when the host Caddy proxies
# to localhost:8080; use the docker bridge IP if Caddy runs in a container.
DASHBOARD_BIND_ADDR=127.0.0.1
# Optional Redis password. When set, the compose redis gets --requirepass and
# the automation client authenticates with it. Empty = no auth (loopback only).
REDIS_PASSWORD=

# ─── Environment ─────────────────────────────────────────────────────────────
# One of local-development | dev-stage | production (the service refuses anything else).
# SECURITY-RELEVANT: in production the auth cookies are sent `secure` (HTTPS only), the
# JWT secret is REQUIRED (no fallback), the local no-auth bypass is disabled, and the
# /dev/trigger endpoint is blocked. "Restart service" on the Settings page is refused
# under local-development (nothing would start the process again).
NODE_ENV=local-development

# ─── Auth / security ─────────────────────────────────────────────────────────
# Secret used to sign dashboard session cookies (JWT). REQUIRED in production —
# the service refuses to start without it there (no built-in fallback). Use a
# long random value, e.g. `openssl rand -hex 32`.
JWT_SECRET=
# Shared admin token. Logging in pastes this to mint a session cookie, and it is
# also accepted as a `Bearer` token on the admin API. If unset, token-login is
# disabled. NOTE: a missing token NO LONGER opens the API (see ALLOW_NO_AUTH).
TRACKING_TOKEN=
# Local-only escape hatch: when "true" AND NODE_ENV is not production AND no
# TRACKING_TOKEN is configured, the admin API accepts unauthenticated requests.
# Off by default. NEVER set this in a deployed environment.
ALLOW_NO_AUTH=false
# Comma-separated Telegram user ids allowed to use Telegram login. FAILS CLOSED:
# empty = Telegram login disabled for everyone (token-login still works).
TRACKING_ALLOWED_TG_USER_IDS=
# Swagger UI at /api/docs is served only outside production, unless this is "true".
SWAGGER_ENABLED=false

# Master key for encrypting stored secrets (AES-256-GCM) at rest: bot / Meta /
# Telegraph tokens, MTProto sessions and every key on the Settings page. Any
# passphrase — it is SHA-256'd to a 32-byte key. Without it, keys and tokens stay
# in this file and cannot be edited on the dashboard. Never change it once set:
# stored secrets would no longer decrypt.
TOKEN_ENCRYPTION_KEY=
# Salt for the promo join/click hashes and landing lead dedup (specs 022, 026).
# Empty: TOKEN_ENCRYPTION_KEY is used; with neither set, dedup resets on restart.
PROMO_HASH_SALT=

# ─── Ports / dashboard build ─────────────────────────────────────────────────
AUTOMATION_PORT=3001
# HTTPS for the public domain (dev.ai0.global) is terminated by the host's
# EXISTING Caddy (the n8n stack's caddy, which already owns :80/:443). Add a
# vhost there: `dev.ai0.global { reverse_proxy <host>:${DASHBOARD_PORT} }`.
# This stack does NOT run its own Caddy. Keep DASHBOARD_PORT off 80/443.
DASHBOARD_PORT=8080
# Dashboard sign-in method, baked into the image at build time (spec 028).
# A bot username → Telegram sign-in; VITE_AUTH_MODE=token → access-token form
# (with both set, Telegram is primary and the token form is a collapsed extra).
# A build with neither fails; the Dockerfile then defaults to token.
VITE_AUTH_MODE=token
VITE_TG_BOT_USERNAME=

# ─── Telegram bot (sign-in and admin bot) ────────────────────────────────────
# Stays here: the Telegram sign-in checks with it, so a wrong value on the
# dashboard could lock you out. Publishing bots live on Connections → Bots.
TELEGRAM_BOT_TOKEN=

# ─── Editor MCP server (spec 006, a separate process without the DB) ──────────
# `pnpm --silent --filter automation editor:mcp` talks to the REST API at
# EDITOR_API_URL with TRACKING_TOKEN. run_slot is shadow-only unless
# EDITOR_MCP_ALLOW_LIVE_RUN=true; set_mode live is never allowed.
EDITOR_API_URL=http://localhost:3000
EDITOR_MCP_ALLOW_LIVE_RUN=false

# ─── LLM budgets (seed only) ─────────────────────────────────────────────────
# Daily LLM spend caps (USD, Kyiv day), all BLOCKING (spec 029). These values only SEED the
# llm_budgets rows on first boot; afterwards edit the caps in Spend → Budgets (no restart).
# Empty = default. Agents (editor.*) $2, each resource $0.30, all AI spend $3.
EDITOR_DAILY_BUDGET_USD=2
EDITOR_CHANNEL_DAILY_BUDGET_USD=0.30
AI_DAILY_BUDGET_USD=3

# ─── Legacy strategy bindings ────────────────────────────────────────────────
# Only the zone the binding → series migration (`migrate:strategies`, @ai0) reads
# the old binding crons in. Unset = process TZ (UTC in Docker).
SCHEDULER_TZ=

# ─── Everything else: Settings → Configuration on the dashboard (spec 039) ────
# API keys, feature switches, limits, schedules, retention windows, session
# lifetimes, payment keys, links … are edited on the dashboard and stored in the
# database (keys encrypted with TOKEN_ENCRYPTION_KEY). Any of them may still be put
# in this file (same names as the Configuration tab shows, e.g.
# OPENROUTER_API_KEY=, EDITOR_ENABLED=true, RETENTION_ENABLED=true): at the next
# start the service copies each value into the database ONCE and from then on the
# dashboard value wins — later edits here are ignored (the page shows them, with
# "Use .env value"). Tokens of bots / Meta / Telegraph accounts that still name an
# env variable (token_env) are moved into the database the same way.
