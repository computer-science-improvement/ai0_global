# ─── PostgreSQL ─────────────────────────────────────────────────────────────
#
# LOCAL dev (outside Docker):
#   POSTGRES_HOST=localhost
#   POSTGRES_PORT=5433    ← host port mapped in docker-compose.yml
#
# Inside Docker (between services):
#   POSTGRES_HOST=postgres  ← docker service name (set automatically by compose)
#   POSTGRES_PORT=5432      ← internal container port (set automatically by compose)
#
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ai0global
POSTGRES_USER=ai0
POSTGRES_PASSWORD=__set_a_strong_password__

# ─── Network exposure / Redis ───────────────────────────────────────────────
# Host address that docker-compose publishes postgres, redis and automation on.
# Default 127.0.0.1 (loopback only). If you rely on remote psql to 5433, set
# BIND_ADDR=0.0.0.0 explicitly — and firewall it.
BIND_ADDR=127.0.0.1
# Same, for the dashboard port only. Keep loopback when the host Caddy proxies
# to localhost:8080; use the docker bridge IP if Caddy runs in a container.
DASHBOARD_BIND_ADDR=127.0.0.1
# Optional Redis password. When set, the compose redis gets --requirepass and
# the automation client authenticates with it. Empty = no auth (loopback only).
REDIS_PASSWORD=

# ─── Environment ─────────────────────────────────────────────────────────────
# Set to "production" on deployed instances. SECURITY-RELEVANT: in production the
# auth cookies are sent `secure` (HTTPS only), the JWT secret is REQUIRED (no
# fallback), the local no-auth bypass is disabled, and the /dev/trigger endpoint
# is blocked. Leaving it unset effectively runs in dev mode.
NODE_ENV=development

# ─── Auth / security ─────────────────────────────────────────────────────────
# Secret used to sign dashboard session cookies (JWT). REQUIRED in production —
# the service refuses to start without it there (no built-in fallback). Use a
# long random value, e.g. `openssl rand -hex 32`.
JWT_SECRET=
# Shared admin token. Logging in pastes this to mint a session cookie, and it is
# also accepted as a `Bearer` token on the admin API. If unset, token-login is
# disabled. NOTE: a missing token NO LONGER opens the API (see ALLOW_NO_AUTH).
TRACKING_TOKEN=
# Local-only escape hatch: when "true" AND NODE_ENV is not production AND no
# TRACKING_TOKEN is configured, the admin API accepts unauthenticated requests.
# Off by default. NEVER set this in a deployed environment.
ALLOW_NO_AUTH=false
# Comma-separated Telegram user ids allowed to use Telegram login. FAILS CLOSED:
# empty = Telegram login disabled for everyone (token-login still works).
TRACKING_ALLOWED_TG_USER_IDS=
# Swagger UI at /api/docs is served only outside production, unless this is "true".
SWAGGER_ENABLED=false
# Dashboard sessions (spec 028). Each login is a revocable row in auth_sessions;
# the cookie holds a short JWT that is renewed while the session is in use.
# Empty = default. Access token lifetime in minutes (default 60):
AUTH_ACCESS_TTL_MIN=
# A session unused for this many days expires (default 7):
AUTH_IDLE_TTL_DAYS=
# Hard cap: re-login this many days after signing in, however active (default 30):
AUTH_ABSOLUTE_TTL_DAYS=
# Days the auth audit log (logins, failures, revokes) is kept (default 180):
AUTH_EVENTS_RETENTION_DAYS=

# ─── Automation service ──────────────────────────────────────────────────────
AUTOMATION_PORT=3001
# Hard wall-clock ceiling (ms) for a single strategy run. A hung external call
# past this is recorded as an error and the in-flight guard is released, so the
# strategy isn't stuck 'running' forever. Default 300000 (5 min).
STRATEGY_RUN_TIMEOUT_MS=300000

# Master key for encrypting stored secret tokens (AES-256-GCM) at rest. Any
# passphrase — it is SHA-256'd to a 32-byte key. Required only to store/read
# encrypted tokens; legacy env-var-name (token_env) tokens work without it.
TOKEN_ENCRYPTION_KEY=

# ─── Public domain / deployment (prod profile) ───────────────────────────────
# HTTPS for the public domain (dev.ai0.global) is terminated by the host's
# EXISTING Caddy (the n8n stack's caddy, which already owns :80/:443). Add a
# vhost there: `dev.ai0.global { reverse_proxy <host>:${DASHBOARD_PORT} }`.
# This stack does NOT run its own Caddy. Keep DASHBOARD_PORT off 80/443.
DASHBOARD_PORT=8080
# Dashboard sign-in method, baked into the image at build time (spec 028).
# A bot username → Telegram sign-in; VITE_AUTH_MODE=token → access-token form
# (with both set, Telegram is primary and the token form is a collapsed extra).
# A build with neither fails; the Dockerfile then defaults to token.
VITE_AUTH_MODE=token
VITE_TG_BOT_USERNAME=
# Where the TikTok OAuth callback redirects back to (the dashboard origin).
# Only needed if using TikTok publishing.
DASHBOARD_URL=https://dev.ai0.global
# TikTok OAuth redirect URI — must EXACTLY match the one registered in the
# TikTok developer app. Only needed if using TikTok publishing.
TIKTOK_REDIRECT_URI=https://dev.ai0.global/api/tiktok/oauth/callback

# ─── Telegram bots ───────────────────────────────────────────────────────────
# Назви змінних відповідають полю "tokenEnv" у apps/automation/config/channels.json
TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT2_TOKEN=    ← другий бот для ротації (опційно)
# Owner chat id for admin notifications. OPTIONAL here — preferably set it in the
# dashboard (Settings → Telegram → TELEGRAM_OWNER_ID); the DB value overrides this.
TELEGRAM_OWNER_ID=

# ─── Instagram (Meta Graph API) ──────────────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# ─── Threads (Meta Threads API) ──────────────────────────────────────────────
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# ─── Facebook (Meta Graph API) ───────────────────────────────────────────────
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# ─── AI agents ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
OPENAI_API_KEY=
GROK_API_KEY=

# ─── Stats module ────────────────────────────────────────────────────────────
# MTProto credentials (https://my.telegram.org) for per-post views/reactions.
# These are now OPTIONAL: prefer managing sessions in the dashboard
# (Connections · Telegram → Sessions), where each session carries its own
# encrypted session string + api_id/api_hash. These env values are used only as
# a fallback when no active DB session exists.
# Generate TELEGRAM_SESSION_STRING once locally:
#   cd apps/automation && npx ts-node scripts/generate-telegram-session.ts
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
# Snapshot only posts younger than this many days
STATS_POST_AGE_DAYS=30
# ⚠ BAN RISK: when "true", the competitor-tracking MTProto client REUSES the
# same personal Telegram user account that PUBLISHES content, for high-cadence
# scraping (GetHistory/ResolveUsername). Telegram flags that read+write pattern
# for spam bans — and a ban then takes down BOTH publishing and tracking. Keep
# this "false" in production and use a separate, low-value tracking account.
TELEGRAM_TRACKING_SHARE_SESSION=false
# Required header for /stats/* REST endpoints (X-API-Key)
STATS_API_KEY=

# ─── Data retention (nightly prune at 03:00) ─────────────────────────────────
# ON by default since spec 007. Deletes old rows from append-only tables (ai_logs
# stores full prompts/outputs and grows fastest; run traces next) and blanks out
# old message text (tracked post bodies, agent DM/chat text, discovery payloads).
# Set RETENTION_ENABLED=false to make the job log-only (nothing is deleted).
# `bot_logs` is never pruned (publish dedup ledger until spec 009).
# Per-table windows below are in DAYS; 0 disables that table. Unset → default shown.
RETENTION_ENABLED=true
# Delete rows older than N days:
AI_LOGS_RETENTION_DAYS=30
POST_SNAPSHOTS_RETENTION_DAYS=90
CHANNEL_SNAPSHOTS_RETENTION_DAYS=90
META_HISTORY_RETENTION_DAYS=365
TRACKED_POST_HISTORY_RETENTION_DAYS=180
TRACKED_SUBS_HISTORY_RETENTION_DAYS=365
STRATEGY_RUNS_RETENTION_DAYS=90
EDITOR_RUN_STEPS_RETENTION_DAYS=30
EDITOR_RUNS_RETENTION_DAYS=180
# Keep the row, blank the text/payload after N days:
#   tracked_posts.text → NULL; agent_dm_threads last_text/draft_reply/sent_reply
#   → NULL; agent_opportunities.message_text → NULL; candidate_channels.raw_payload → '{}'
TRACKED_POST_TEXT_RETENTION_DAYS=30
AGENT_DM_TEXT_RETENTION_DAYS=90
AGENT_OPPORTUNITY_TEXT_RETENTION_DAYS=90
CANDIDATE_RAW_PAYLOAD_RETENTION_DAYS=30

# ─── Failure alerting (every 15 min → owner via Telegram) ────────────────────
# Pings TELEGRAM_OWNER_ID when a strategy fails repeatedly or a run is stuck.
# Needs TELEGRAM_BOT_TOKEN + an owner id (else it silently no-ops). Set
# ALERT_ENABLED=false to turn the watcher off entirely.
ALERT_ENABLED=true
# Alert after this many consecutive errors (since the last ok/skipped run).
ALERT_CONSECUTIVE_ERRORS=3
# Alert when a run has been 'running' longer than this many minutes.
ALERT_STUCK_RUNNING_MINUTES=20

# ─── Agent (DM triage; off by default) ───────────────────────────────────────
# Reads incoming DMs on the mtproto_sessions row with role='agent', classifies
# them with Claude, and surfaces drafts in the dashboard. Read-only — never sends.
AGENT_ENABLED=false
AGENT_POLL_CRON=*/5 * * * *
AGENT_TRIAGE_MODEL=
AGENT_TRIAGE_MAX_TOKENS=800
# Max DM replies the agent may send per rolling 24h (approval-gated). Default 20.
AGENT_REPLY_DAILY_CAP=20
# Chat-intel: monitor already-joined group chats for ad/ВП opportunities (read-only).
AGENT_CHAT_ENABLED=false
AGENT_CHAT_POLL_CRON=*/15 * * * *
AGENT_CHAT_MAX=20

# ─── Payments (LiqPay hosted checkout; ad placements) ────────────────────────
# Merchant keys from the LiqPay dashboard. PRIVATE key is a secret — never commit
# a real value. The webhook posts to ${DASHBOARD_URL}/api/payments/liqpay/callback
# and is authenticated by LiqPay's signature (not our auth guard).
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
# Count LiqPay `sandbox` callbacks as paid. ONLY for testing with sandbox keys —
# leave false in production (otherwise a sandbox payment marks a real order paid).
LIQPAY_SANDBOX=false
AD_ORDER_CURRENCY=UAH

# ─── Strategy scheduler ──────────────────────────────────────────────────────
# Time zone for binding cron expressions. Unset = process TZ (UTC in Docker) —
# the historical behaviour. Recommended: Europe/Kyiv, but review existing
# bindings first: switching shifts every schedule 2–3 h earlier.
SCHEDULER_TZ=

# ─── Editor agent (specs/003–005) ────────────────────────────────────────────
# Autonomous per-channel editor: plans the day, writes and publishes posts.
# Global kill switch — nothing runs unless true AND a channel card
# (editor_channels) has mode shadow/live. Start with shadow. See
# docs/runbooks/editor-agent.md.
EDITOR_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Per-role model overrides (default z-ai/glm-5.3-flash); a card's `models` wins.
EDITOR_MODEL_PLANNER=
EDITOR_MODEL_EXECUTOR=
EDITOR_MODEL_REVIEWER=
# Daily LLM spend caps (USD, Kyiv day), all BLOCKING (spec 029). These values only SEED the
# llm_budgets rows on first boot; afterwards edit the caps in the DB / Spend → Budgets (no restart).
# Empty = default. Agents (editor.*) $2, each resource $0.30, all AI spend $3.
EDITOR_DAILY_BUDGET_USD=2
EDITOR_CHANNEL_DAILY_BUDGET_USD=0.30
AI_DAILY_BUDGET_USD=3
# Raw llm_usage rows are kept this many days (the daily rollup is kept forever).
LLM_USAGE_RETENTION_DAYS=90
# Send shadow-mode previews to the owner via the admin bot (default on).
EDITOR_SHADOW_PREVIEW=true
# Editor MCP server (spec 006, `pnpm --silent --filter automation editor:mcp`):
# talks to the REST API at EDITOR_API_URL with TRACKING_TOKEN. run_slot is
# shadow-only unless EDITOR_MCP_ALLOW_LIVE_RUN=true; set_mode live is never allowed.
EDITOR_API_URL=http://localhost:3000
EDITOR_MCP_ALLOW_LIVE_RUN=false

# ─── Pipeline options ────────────────────────────────────────────────────────
FETCH_TIMEOUT=15000


# Telegraph (telegra.ph) access token — minted via api.telegra.ph/createAccount.
# Referenced by telegraph_accounts.token_env (account_id="default").
TELEGRAPH_ACCESS_TOKEN=
