# ─── PostgreSQL ─────────────────────────────────────────────────────────────
#
# LOCAL dev (outside Docker):
#   POSTGRES_HOST=localhost
#   POSTGRES_PORT=5433    ← host port mapped in docker-compose.yml
#
# Inside Docker (between services):
#   POSTGRES_HOST=postgres  ← docker service name (set automatically by compose)
#   POSTGRES_PORT=5432      ← internal container port (set automatically by compose)
#
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ai0global
POSTGRES_USER=ai0
POSTGRES_PASSWORD=changeme

# ─── Automation service ──────────────────────────────────────────────────────
AUTOMATION_PORT=3001

# ─── Telegram bots ───────────────────────────────────────────────────────────
# Назви змінних відповідають полю "tokenEnv" у apps/automation/config/channels.json
TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT2_TOKEN=    ← другий бот для ротації (опційно)

# ─── Instagram (Meta Graph API) ──────────────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# ─── Threads (Meta Threads API) ──────────────────────────────────────────────
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# ─── Facebook (Meta Graph API) ───────────────────────────────────────────────
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# ─── AI agents ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
OPENAI_API_KEY=
GROK_API_KEY=

# ─── Stats module ────────────────────────────────────────────────────────────
# MTProto credentials (https://my.telegram.org) for per-post views/reactions.
# Generate TELEGRAM_SESSION_STRING once locally:
#   cd apps/automation && npx ts-node scripts/generate-telegram-session.ts
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
# Snapshot only posts younger than this many days
STATS_POST_AGE_DAYS=30
# Required header for /stats/* REST endpoints (X-API-Key)
STATS_API_KEY=

# ─── Pipeline options ────────────────────────────────────────────────────────
FETCH_TIMEOUT=15000


# Telegraph (telegra.ph) access token — minted via api.telegra.ph/createAccount.
# Referenced by telegraph_accounts.token_env (account_id="default").
TELEGRAPH_ACCESS_TOKEN=
